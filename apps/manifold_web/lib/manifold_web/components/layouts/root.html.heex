<!doctype html>
<html lang="en" data-theme="sunshine">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" - Manifold">{assigns[:page_title] || "Manifold"}</.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script>
      (() => {
        try {
          const stored = localStorage.getItem("theme") || "default";
          const resolved =
            !stored || stored === "default"
              ? window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "moonlight"
                : "sunshine"
              : stored;
          document.documentElement.setAttribute("data-theme", resolved);
        } catch (_error) {
          document.documentElement.setAttribute("data-theme", "sunshine");
        }
      })();
    </script>
    <link
      phx-track-static
      rel="stylesheet"
      href={
        DuskmoonBundler.static_path(ManifoldWeb.Endpoint, "/assets/css/app.css",
          profile: :manifold_web
        )
      }
    />
    {DuskmoonBundler.Preload.tags(ManifoldWeb.Endpoint, "/assets/js/app.js",
      profile: :manifold_web
    )}
    <script
      defer
      phx-track-static
      type="module"
      src={
        DuskmoonBundler.static_path(ManifoldWeb.Endpoint, "/assets/js/app.js",
          profile: :manifold_web
        )
      }
    >
    </script>
  </head>
  <body class="bg-surface text-on-surface min-h-screen">
    {@inner_content}
  </body>
</html>
