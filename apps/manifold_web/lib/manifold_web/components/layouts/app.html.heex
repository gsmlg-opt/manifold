<div class="app-shell">
  <header class="app-header">
    <.link navigate={~p"/"} class="brand">
      <.dm_mdi name="email-multiple-outline" class="brand-icon" /> Manifold
    </.link>
    <nav aria-label="Application">
      <.nav_link to={~p"/"}>Mail</.nav_link>
      <.nav_link to={~p"/deliveries"}>Operations</.nav_link>
      <.nav_link to={~p"/cloud"}>Cloud</.nav_link>
      <.nav_link to={~p"/mailboxes"}>Settings</.nav_link>
    </nav>
  </header>
  <main class="content">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
